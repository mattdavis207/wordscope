{
  "name": "word-scope",
  "displayName": "Word scope",
  "version": "0.0.1",
  "description": "Instantly understand any word, anywhere.",
  "author": "Matthew Davis <matthewdavis207gmail.com>",
  "scripts": {
    "dev:ext": "plasmo dev",
    "build:ext": "plasmo build",
    "package:ext": "plasmo package",
    "dev:api": "nodemon src/index.ts",
    "start:api": "ts-node src/index.ts"
  },
  "dependencies": {
    "@hello-pangea/dnd": "^18.0.1",
    "@mozilla/readability": "^0.6.0",
    "@types/cors": "^2.8.19",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "framer-motion": "^12.23.0",
    "google-dictionary-api": "^1.0.8",
    "isnan": "^0.0.0",
    "jspdf": "^3.0.1",
    "marked": "^16.0.0",
    "mozilla": "^0.0.0",
    "overscroll": "^0.0.39",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-colorful": "^5.6.1",
    "react-dom": "18.2.0",
    "react-icons": "^5.5.0",
    "react-sortablejs": "^6.1.4",
    "sortablejs": "^1.15.6",
    "string-strip-html": "^13.4.12",
    "stripe": "^18.3.0",
    "tailwind-scrollbar": "^4.0.2"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@ljharb/tsconfig": "^0.3.2",
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/chrome": "0.0.258",
    "@types/express": "^5.0.3",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "nodemon": "^3.1.10",
    "parcel": "2.9.3",
    "prettier": "3.2.4",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3"
  },
  "manifest": {
    "host_permissions": [
      "https://*/*",
      "https://wordscope-extension.vercel.app/*",
      "chrome-extension://mhjfbmdgcfjbbpaeojofohoefgiehjai/*"
    ],
    "permissions": [
      "contextMenus",
      "storage",
      "sidePanel",
      "tabs",
      "scripting"
    ],
    "web_accessible_resources": [
      {
        "resources": [
          "assets/styles/tailwind-content.css",
          "assets/Wordscope-Demo-Video.mp4",
          "assets/SettingsDemo.mp4",
          "assets/definitions/*.png",
          "assets/contextai/*.png",
          "assets/contextai/*.gif",
          "assets/sidepanel/*.gif",
          "assets/sidepanel/*.png",
          "assets/history/*.gif",
          "assets/util-buttons/*.gif"
        ],
        "matches": ["<all_urls>"]
      }
    ],
    "content_security_policy": {
      "extension_pages": "script-src 'self'; object-src 'none'; font-src 'self' data:; img-src 'self' data: chrome-extension: blob:; style-src 'self' 'unsafe-inline'; media-src 'self' data: blob: https://api.dictionaryapi.dev https://*.dictionaryapi.dev; child-src 'self'; frame-src 'self'; connect-src 'self' https://wordscope-extension.vercel.app https://api.openai.com https://api.dictionaryapi.dev https://wordsapiv1.p.rapidapi.com https://en.wiktionary.org https://www.dictionaryapi.com https://api.datamuse.com https://api.duckduckgo.com https://lingua-robot.p.rapidapi.com ws://localhost:1815 ws://localhost:1816; worker-src 'self'; form-action 'none';"
    }
  }
}
